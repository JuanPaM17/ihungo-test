meta {
  name: Crear Asociado
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/api/asociados/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{TOKEN}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "nuevo@example.com",
    "password": "segura1234",
    "identification": "123456789",
    "first_name": "Nuevo",
    "last_name": "Asociado",
    "city": "Bogotá"
  }
}

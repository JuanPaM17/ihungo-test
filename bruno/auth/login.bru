meta {
  name: Login (obtener JWT)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/auth/token/
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@example.com",
    "password": "tu_password"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("access_token", res.body.access);
    bru.setEnvVar("refresh_token", res.body.refresh);
  }
}

# ── General ───────────────────────────────────────────────────────────────────
APP_PORT=8001
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Select provider: openai | gemini  (default: openai)
MODEL_PROVIDER=openai

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_FAST=gpt-4.1-nano
OPENAI_MODEL_EVALUATOR=gpt-4.1-mini

# ── Gemini ────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MODEL_FAST=gemini-2.0-flash
# GEMINI_MODEL_EVALUATOR=gemini-2.0-flash

# ── LangSmith (observabilidad, opcional) ──────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2_"
LANGCHAIN_PROJECT=ihungo

# ── CORS ──────────────────────────────────────────────────────────────────────
# Usar * para aceptar cualquier origen, o lista separada por coma
CORS_ALLOWED_ORIGINS=*

# ── Backend ihungo (Backend 4) ────────────────────────────────────────────────
API_ENDPOINT=http://localhost:8080
API_REQUEST_TIME_OUT=30

# ── CLI conversacional ────────────────────────────────────────────────────────
# URL del Backend 4 (autenticacion JWT)
BACKEND_API_URL=http://localhost:8080
# URL del agente IA
AGENT_API_URL=http://localhost:8001
# Modo streaming SSE: true | false (default: false = JSON)
CLI_STREAMING=false
# Timeout en segundos para requests del CLI
CLI_REQUEST_TIMEOUT=120

# ── Configuration Files V2 ────────────────────────────────────────────────────
TENANT_CONFIG_BASE_PATH=config/v2/tenants
DYNAMIC_AGENTS_CONFIG_PATH=dynamic_agents_config.json
PROMPTS_AGENTS_BASE_PATH=prompts/agents
PROMPTS_BASE_PATH=prompts
GENERAL_PROMPT_PATH=config/v2/prompts/general_prompt.md

# General APP
LLM_API_KEY=sk-
LLM_MODEL=gpt-4.1-nano
MODEL_PROVIDER=openai
LLM_TEMPERATURE=0.0
APP_PORT=8001

# Langsmith - Logs
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2"
LANGCHAIN_PROJECT=default    

# OpenAI
OPENAI_API_KEY=sk-proj-

# CORS — usar * para aceptar cualquier origen, o lista separada por coma
CORS_ALLOWED_ORIGINS=*

# API Backend ihungo (Backend 4)
API_ENDPOINT=http://localhost:8080
API_REQUEST_TIME_OUT=30

# Configuration Files V2
TENANT_CONFIG_BASE_PATH=config/v2/tenants
DYNAMIC_AGENTS_CONFIG_PATH=dynamic_agents_config.json
PROMPTS_AGENTS_BASE_PATH=prompts/agents
PROMPTS_BASE_PATH=prompts
GENERAL_PROMPT_PATH=config/v2/prompts/general_prompt.md

{
    "dynamic_agents": {
        "greeting_agent": {
            "prompt_path": "greeting_agent.md",
            "llm_model": "default",
            "recursion_limit": 1
        },
        "actividades_agent": {
            "agent_type": "react",
            "prompt_path": "actividades_agent.md",
            "tool_names": [
                "list_actividades",
                "create_actividad",
                "update_actividad",
                "delete_actividad",
                "consultar_disponibilidad",
                "list_asociados",
                "buscar_asociados",
                "get_datetime"
            ],
            "llm_model": "default",
            "recursion_limit": 5
        },
        "asociados_agent": {
            "agent_type": "react",
            "prompt_path": "asociados_agent.md",
            "tool_names": [
                "list_asociados",
                "buscar_asociados",
                "obtener_asociado",
                "crear_asociado",
                "actualizar_asociado",
                "eliminar_asociado"
            ],
            "llm_model": "default",
            "recursion_limit": 5
        }
    },
    "supervisor_config": {
        "supervisor": {
            "prompt_path": "supervisor_prompt.md",
            "llm_model": "default",
            "description": "Primary supervisor for ihungo users",
            "agent_names": [
                "greeting_agent",
                "actividades_agent",
                "asociados_agent"
            ],
            "handoff_descriptions": {
                "greeting_agent": "Use for initial greetings and displaying the list of available services.",
                "actividades_agent": "Use for ANY query about actividades or availability: listing, creating, updating, or deleting activities, and checking who is free or busy on a given date.",
                "asociados_agent": "Use for ANY query about asociados as people: listing, searching, viewing, creating, updating, or deleting asociados."
            }
        }
    }
}
